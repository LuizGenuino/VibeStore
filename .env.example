# URL do projeto Supabase (Auth, PostgREST, Storage)
VITE_SUPABASE_URL=https://xyz.supabase.co

# Chave anon/publishable — a ÚNICA permitida no navegador. NUNCA service_role/secret.
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Base pública do app (usada em redirectTo / emailRedirectTo; deve ser igual ao APP_URL da Edge storefront-api)
VITE_APP_URL=http://localhost:5173

# Endpoint da Edge Function (opcional; se omitido é derivado de VITE_SUPABASE_URL)
# VITE_STOREFRONT_API_URL=${VITE_SUPABASE_URL}/functions/v1/storefront-api
